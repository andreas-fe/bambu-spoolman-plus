BAMBU_HOST=192.0.2.50
BAMBU_ACCESS_CODE=replace-with-lan-access-code
BAMBU_SERIAL=replace-with-printer-serial
# Existing Spoolman instance, reachable from the bridge container:
SPOOLMAN_URL=http://spoolman:8000
SPOOLMAN_NETWORK=spoolman-network
SPOOLMAN_BROWSER_URL=http://192.0.2.10:7912
DRY_RUN=true
AUTO_MATCH_FILAMENTS=true
BRIDGE_PORT=7913
# Persistent local path on the Docker host (QNAP), not the notebook mount:
BRIDGE_DATA_DIR=./data
# Optional: set both values to protect the web interface.
WEB_USERNAME=
WEB_PASSWORD=

# Umschaltung erst nach Vollbackup, Testimport und offline aktiviertem Inventar.
INVENTORY_BACKEND=spoolman
# Optionale Tapo-Secrets: private Dateien im gemounteten Datenverzeichnis.
# TAPO_HOST_FILE=/app/data/secrets/tapo_host
# TAPO_USERNAME_FILE=/app/data/secrets/tapo_username
# TAPO_PASSWORD_FILE=/app/data/secrets/tapo_password

# Für die Modellprüfung beim Druckstart aus dem Speicher (A1 mini entsprechend anpassen)
BAMBU_MODEL=Bambu Lab A1
